*.log
*.tmp
*.temp
*.swp
*.DS_Store

# Environment / secret files
.env
*.keystore
*.jks
*.p12

# Node / frontend (se tiver)
node_modules/
dist/

# Ignore rsa public and private keys
src/main/resources/*.key
src/main/resources/*.pub


# FRONTEND
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

